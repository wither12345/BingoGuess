{
  "type": "minecraft:multi_action",
  "title": "猜词",
  "external_title": "猜词",
  "pause": false,
  "after_action": "close",
  "can_close_with_escape": true,
  "columns": 2,
  "body": {
    "type": "minecraft:plain_message",
    "contents": "输入名称后选择“提交猜测”；只记得一部分时选择“查询”。",
    "width": 310
  },
  "inputs": [
    {
      "type": "minecraft:text",
      "key": "name",
      "label": "名称",
      "width": 310,
      "max_length": 32
    }
  ],
  "actions": [
    {
      "label": "提交猜测",
      "width": 150,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "guess $(name)"
      }
    },
    {
      "label": "查询",
      "width": 150,
      "action": {
        "type": "minecraft:dynamic/run_command",
        "template": "gb search $(name)"
      }
    },
    {
      "label": "历史记录",
      "width": 150,
      "action": {
        "type": "minecraft:run_command",
        "command": "gb history"
      }
    },
    {
      "label": "当前状态",
      "width": 150,
      "action": {
        "type": "minecraft:run_command",
        "command": "gb status"
      }
    },
    {
      "label": "玩法说明",
      "width": 150,
      "action": {
        "type": "minecraft:run_command",
        "command": "gb rules"
      }
    }
  ],
  "exit_action": {
    "label": "关闭",
    "width": 150
  }
}
